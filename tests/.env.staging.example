# ==============================================================================
# TEMPLATE: Staging Environment Configurations
# Copy this file to 'tests/.env.staging' and update with actual staging secrets.
# NEVER commit the active 'tests/.env.staging' or '.env.staging' files to Git!
# ==============================================================================

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://your_staging_db_host:5432/cloudshare
SPRING_DATASOURCE_USERNAME=cloudshare_staging_user
SPRING_DATASOURCE_PASSWORD=your_staging_db_password_here

# Cache-Aside Redis Configuration
SPRING_DATA_REDIS_HOST=your_staging_cache_redis_host_here
SPRING_DATA_REDIS_PORT=6379
REDIS_CACHE_PASSWORD=your_staging_cache_redis_password_here

# Security Redis Configuration
SECURITY_REDIS_HOST=your_staging_security_redis_host_here
SECURITY_REDIS_PORT=6380
REDIS_SECURITY_PASSWORD=your_staging_security_redis_password_here

# Rate-Limiting Redis Configuration
RATE_LIMIT_REDIS_HOST=your_staging_rate_limit_redis_host_here
RATE_LIMIT_REDIS_PORT=6381
REDIS_RATELIMIT_PASSWORD=your_staging_rate_limit_redis_password_here

# JWT Security Configurations
# Secret must be at least 512 bits (64 characters) for HMAC-SHA512
JWT_SECRET=your_staging_jwt_secret_key_at_least_64_characters_here_please_change
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
# Absolute lifetime (seconds) of an MFA step-up admin session, measured from the original
# MFA verification instant, regardless of how many times the step-up token rotates in between.
JWT_STEP_UP_SESSION_MAX=900

# MinIO Object Storage Configuration
MINIO_ROOT_USER=cloudshare_staging_minio
MINIO_ROOT_PASSWORD=your_staging_minio_password_here

# Cryptography Configurations
CRYPTO_MASTER_KEK=your_staging_crypto_master_kek_32_bytes_here

# Rate Limiting Configurations (defaults shown)
RATE_LIMIT_AUTH=10
RATE_LIMIT_MFA=10
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_LINK=50
RATE_LIMIT_LINK_GLOBAL=100
RATE_LIMIT_GENERAL=200
RATE_LIMIT_ENABLED=true

# Password Breach Check Configurations
PASSWORD_BREACH_CHECK_ENABLED=true
PASSWORD_BREACH_CHECK_TIMEOUT_MS=3000

# ClamAV Concurrency Configurations
CLAMAV_MAX_CONCURRENT_SCANS=8
CLAMAV_CONCURRENCY_TIMEOUT_SECONDS=30

# Download Concurrency Configurations
STORAGE_MAX_CONCURRENT_DECRYPT_DOWNLOADS=20
STORAGE_DECRYPT_ACQUIRE_TIMEOUT_SECONDS=10

# Pagination Configurations
SPRING_DATA_WEB_PAGEABLE_MAX_PAGE_SIZE=100
SPRING_DATA_WEB_PAGEABLE_ONE_INDEXED_PARAMETERS=false
